generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Synagogue community member record
model Member {
  id                     String   @id @default(cuid())
  email                  String   @unique
  passwordHash           String?
  firstName              String
  lastName               String
  phone                  String
  street                 String
  city                   String
  halachicStatus         String   @default("yisrael") // kohen | levi | yisrael
  role                   String   @default("member") // member | gabay | super_admin
  isApproved             Boolean  @default(false)
  showPhoneInDirectory   Boolean  @default(true)
  showAddressInDirectory Boolean  @default(true)
  receiveNewsletter      Boolean  @default(true)
  toddlerChildren        Int      @default(0)
  elementaryChildren     Int      @default(0)
  teenChildren           Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  yahrzeits       Yahrzeit[]
  transactions    Transaction[]
  communityEvents CommunityEvent[]
}

// Memorial tracking for weekly aliyot and memorial prayers
model Yahrzeit {
  id              String   @id @default(cuid())
  deceasedName    String
  relation        String // father | mother | brother | sister | spouse | child | other
  hebrewDay       Int
  hebrewMonth     String
  diedAfterSunset Boolean  @default(false)
  notes           String?
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

// Public join requests awaiting gabay review
model JoinRequest {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String
  address     String
  city        String   @default("")
  about       String?
  isProcessed Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Synagogue financial ledger synced via Nedarim Plus
model Transaction {
  id            String   @id @default(cuid())
  transactionId String   @unique // Nedarim Plus external transaction ID
  clientName    String
  amount        Float
  targetFund    String
  phone         String?
  email         String?
  memberId      String?
  member        Member?  @relation(fields: [memberId], references: [id])
  // PLACEHOLDER: Nedarim Plus's recurring-donation (standing order) webhook
  // field names are not yet known - these default to false/null until the
  // real payload shape is confirmed. See TODO in the webhook route.
  isRecurring   Boolean  @default(false)
  recurringId   String? // Groups installments of the same standing order, once known
  createdAt     DateTime @default(now())
}

// A community newsletter, built in the admin newsletter editor and sent by
// email to approved members who have not opted out.
model Newsletter {
  id          String    @id @default(cuid())
  subject     String
  targetGroup String    @default("all") // all | board | volunteers
  items       Json // NewsletterItem[]: { category, title, body, imageUrl }
  status      String    @default("draft") // draft | sent
  sentCount   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentAt      DateTime?
}

// Community simchas and events, gabay-managed, shown on the homepage
model CommunityEvent {
  id             String   @id @default(cuid())
  title          String
  type           String // brit_yitzchak | shabbat_chatan | bar_mitzvah | wedding | general
  description    String
  eventDate      DateTime // used for sorting/filtering "upcoming"
  eventDateLabel String // free-text Hebrew-date display string, e.g. "אור לכ"ג בשבט"
  location       String?
  memberId       String? // the celebrating member, if applicable
  member         Member?  @relation(fields: [memberId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
